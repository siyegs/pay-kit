{
  "name": "@siyegs/pay-kit",
  "version": "0.10.1",
  "description": "One typed SDK for African payment rails - unified Paystack & Flutterwave: charge, verify, refund, transfer/payout, resolve accounts, list banks, and verify webhooks, with provider fallback and a keyless mock provider for tests.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siyegs/pay-kit.git"
  },
  "homepage": "https://github.com/siyegs/pay-kit#readme",
  "bugs": {
    "url": "https://github.com/siyegs/pay-kit/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "require": "./dist/next.cjs"
    },
    "./nestjs": {
      "types": "./dist/nestjs.d.ts",
      "import": "./dist/nestjs.js",
      "require": "./dist/nestjs.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js",
      "require": "./dist/hono.cjs"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "import": "./dist/fastify.js",
      "require": "./dist/fastify.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:dist": "bun run build && bun test ./scripts/smoke-dist.test.ts",
    "integration": "bun run scripts/integration.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run test:dist"
  },
  "keywords": [
    "paystack",
    "flutterwave",
    "payments",
    "payment-gateway",
    "payouts",
    "transfers",
    "bank-resolution",
    "testing",
    "mock",
    "nigeria",
    "africa",
    "fintech",
    "typescript",
    "sdk",
    "webhooks"
  ],
  "author": "Iyegere Success Karboloo",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.28",
    "@types/bun": "^1.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "@nestjs/common": ">=9"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    }
  }
}
